# =============================================
# API Facturación Electrónica CR — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env al repositorio.
# =============================================

# ── Base de Datos (PostgreSQL) ──────────────────────────────────
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://user:password@localhost:5432/api_facturacion

# ── Cifrado de Credenciales ─────────────────────────────────────
# Clave de 32 bytes (64 caracteres hex). Genera con: openssl rand -hex 32
# ⚠️  Si cambias esta clave, los datos cifrados existentes NO podrán descifrarse.
ENCRYPTION_KEY=

# ── Firebase (Backend) ──────────────────────────────────────────
# ID del proyecto Firebase (sin prefijo VITE_)
FIREBASE_PROJECT_ID=tu-project-id

# Bucket de Firebase Storage (formato: proyecto-id.appspot.com o proyecto-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app

# JSON completo del Service Account para producción (Render, Railway, etc.)
# Descarga desde: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Pega el contenido del JSON aquí en una sola línea (o como variable de entorno multilinea en Render)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Hacienda ATV ────────────────────────────────────────────────
# URL del Identity Provider de Hacienda (staging o producción)
# Staging:    https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token
# Producción: https://idp.comprobanteselectronicos.go.cr/auth/realms/rut/protocol/openid-connect/token
HACIENDA_IDP_URL=https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token

# Client ID del IDP de Hacienda
# Staging: api-stag | Producción: api
HACIENDA_IDP_CLIENT_ID=api-stag

# URL de recepción de comprobantes de Hacienda
# Staging:    https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/recepcion
# Producción: https://api.comprobanteselectronicos.go.cr/recepcion/v1/recepcion
HACIENDA_API_URL=https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/recepcion

# ── CORS ────────────────────────────────────────────────────────
# Lista de orígenes permitidos separados por coma. Sin espacios.
# Incluye el puerto si usas dev server (ej. localhost:5173 para Vite)
ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.vercel.app

# ── Email SMTP (Notificaciones al receptor) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Cuenta de correo remitente
SMTP_USER=notificaciones@tuempresa.com
# Contraseña de aplicación (NO la contraseña de la cuenta Gmail)
# Crear en: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
SMTP_PASS=

# ── Servidor ────────────────────────────────────────────────────
PORT=3000
